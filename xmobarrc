Config { 
  -- https://github.com/jaor/xmobar
   
  ---- COLOR PALETTE --
  -- cWhite  = "#DFDFDF"
  -- cGray   = "#969595"
  -- cBlack  = "#1C1C1C"
  -- cRed1   = "#AF8787"
  -- cRed2   = "#D75F5F"
  -- cGreen1 = "#87AFAF"
  -- cGreen2 = "#AFD7D7"

  -- appearance
    font 	= "Inconsolata Regular 19"
  , bgColor 	= "black"   -- background of bar color
  , fgColor 	= "#DFDFDF"    -- standard element font color
  , position 	= TopH 33
  , border 	= NoBorder
   
  -- layout
  , sepChar =  "%"   -- delineator between plugin names and straight text
  , alignSep = "}{"  -- separator between left-right alignment
  , template = " %XMonadLog%}{| %multicoretemp% | %memory% | %wi% | %battery% | %KBUR% | %date% "

  -- general behavior
  , lowerOnStart =     True    -- send to bottom of window stack on start
  , hideOnStart =      False   -- start with window unmapped (hidden)
  , allDesktops =      True    -- show on all desktops
  , overrideRedirect = False   -- set the Override Redirect flag (Xlib)
  , pickBroadest =     False   -- choose widest display (multi-monitor)
  , persistent =       True    -- enable/disable hiding (True = disabled)

  , commands = 
    [ Run Memory     
      [ "--template" ,"M <usedratio>"
      , "--Low"      , "20"        -- units: %
      , "--High"     , "90"        -- units: %
      , "--low"      , "#87AFAF"
      , "--normal"   , "#AFD7D7"
      , "--high"     , "#AF8787"
      ] 30

    , Run Battery    
      [ "--template" , "P <acstatus>"
      , "--Low"      , "10"        -- units: %
      , "--High"     , "80"        -- units: %
      , "--low"      , "#AF8787"
      , "--normal"   , "#AFD7D7"
      , "--high"     , "#87AFAF"
      , "--" -- battery specific options below
      -- discharging status
      , "-o"	 , "<left>" 
      -- charged status
      , "-i"         , "<fc=#87AFAF>100</fc>" 
      ] 100
                
    -- cpu		
    , Run MultiCoreTemp  
      [ "--template" , "CPU <max>°C"
      , "--Low"	    , "60"
      , "--High"     , "80"
      , "--low"      , "#87AFAF"
      , "--normal"   , "#AFD7D7"
      , "--high"     , "#AF8787"
      ] 100
                
    -- time and date indicator 
    --   (%F = y-m-d date, %a = day of week, %T = h:m:s time)
    , Run Date "<fc=#DFDFDF>%a, %b %d %Y | %r</fc>" "date" 10
                
    -- weather monitor (18000 refresh every 30 min)
    , Run Weather "KBUR" 
      ["-t", "<tempF>°F <skyCondition>"
      , "-L"         , "65"
      , "-H"         , "85"
      , "--high"     , "#AF8787"
      , "--normal"   , "#AFD7D7"
      , "--low"      , "#87AFAF"
      ] 18000
      
    -- wireless network monitor
    -- Can replace W: with <ssid> for wifi name
    , Run Wireless "" 
      [ "--template" , "W <qualitybar>"
      , "--Low"      , "20"
      , "--High"     , "80"
      , "--low"      , "#AF8787"
      , "--normal"   , "#AFD7D7"
      , "--high"     , "#87AFAF"
      , "-f"         , ":"
      , "-b"         , "."
      ] 100
                

    -- status about which layout and workspace
    , Run XMonadLog
    ]
} 


